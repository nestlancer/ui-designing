{
  "id": "H011",
  "type": "header",
  "family": "Two-tier utility + main",
  "axes": {
    "A1_container_geometry": "1200 contained",
    "A2_nav_paradigm": "inline",
    "A3_scroll_behaviour": "sticky",
    "A4_motion_primitive": "m-02",
    "A5_disclosure": "keyboard-first",
    "A6_cta_treatment": "split-arrow pill"
  },
  "signature_motion": {
    "id": "m-02",
    "name": "Hide-down / show-up",
    "trigger": "scroll direction change",
    "duration_ms": 320,
    "easing": "ease-out"
  },
  "citations": {
    "captured_sites": [
      "remoteok.com",
      "resend.com"
    ],
    "motion_index": "research/motion-index.json",
    "pattern_index": "research/pattern-index.json"
  },
  "diff_from_prev": [
    "A1",
    "A3",
    "A6",
    "A5",
    "A4"
  ],
  "tokens": "chrome-lab/tokens/tokens.css (§2.2 locked, light + derived dark)",
  "responsive": [
    "360",
    "768",
    "1024",
    "1440",
    "1920"
  ],
  "a11y": {
    "skip_link": true,
    "landmark_role": "banner",
    "focus_visible_ring": "2px solid var(--n-teal) + 2px offset",
    "aria_expanded_wired": true,
    "escape_closes": true,
    "current_page_marked": true
  },
  "theme": {
    "light": true,
    "dark": true
  },
  "reduced_motion": "opacity-only 150ms; marquee/parallax/curtain/scrub disabled",
  "budget": {
    "js_bytes": 3608,
    "css_bytes": 18600,
    "html_bytes": 4128,
    "cls": 0
  },
  "mount": "<header data-chrome=\"H011\" data-theme=\"light\" data-page=\"pricing\"></header>",
  "files": {
    "html": "H011/index.html",
    "css": "H011/style.css",
    "js": "H011/script.js"
  }
}